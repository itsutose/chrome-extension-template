{
  "manifest_version": 3,
  "name": "Chrome Extension TypeScript Debug Sample",
  "version": "1.0.0",
  "description": "TypeScript Chrome Extension with debugging support",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "identity"
  ],
  "oauth2": {
    "client_id": "714349689908-kpeq3i0dss21c9jdogjaejhue08q06qv.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Extension Popup"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"]
    }
  ]
} 
+    const authUrl = `https://accounts.google.com/o/oauth2/auth` +
+      `?client_id=${clientId}` +
+      `&response_type=token` +
+      `&redirect_uri=${encodeURIComponent(redirectUri)}` +
+      `&scope=${encodeURIComponent(scope)}`;

{
  "name": "chrome-extension-vite-sample",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location .eslintcache",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "build:extension": "vite build --mode production",
    "start:brave": "./start-brave.sh",
    "start:brave:debug": "./start-brave-debug.sh",
    "stop:brave:debug": "./stop-brave-debug.sh",
    "reset:brave:debug": "./reset-brave-debug.sh",
    "auto-reload": "node scripts/auto-reload.js",
    "dev:auto": "npm run auto-reload"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/chrome": "^0.0.268",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^6.3.5",
    "vite-plugin-web-extension": "^4.1.6"
  }
}

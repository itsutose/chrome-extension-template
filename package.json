{
  "name": "chrome-extension-vite-sample",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "//--- Development ---": "echo",
    "dev": "vite",
    "dev:auto": "npm run auto-reload",

    "//--- Build ---": "echo",
    "build": "tsc -b && vite build",
    "build:clean": "rm -rf dist/* && tsc -b && vite build",
    "build:extension": "vite build --mode production",

    "//--- Browser Control ---": "echo",
    "brave:start": "scripts/brave-ctl.sh start",
    "brave:start:debug": "scripts/brave-ctl.sh start-debug",
    "brave:stop": "scripts/brave-ctl.sh stop",
    "brave:reset": "scripts/brave-ctl.sh reset",
    
    "//--- Lint ---": "echo",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location .eslintcache",
    "preview": "vite preview",

    "//--- Test ---": "echo",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.js",
    "test:integration:watch": "jest --config jest.integration.config.js --watch"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/chrome": "^0.0.268",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^6.3.5",
    "vite-plugin-web-extension": "^4.1.6"
  }
}

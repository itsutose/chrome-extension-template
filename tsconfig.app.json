{
  "compilerOptions": {
    // "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo", build時にcacheを使う設定、大規模になったら有効にしよう
    "target": "ES2022", // JavaScriptの出力バージョン
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],  // 利用可能なライブラリ、API、機能（DOM操作、配列操作など）
    "module": "ESNext",  // モジュールシステムの種類
    "skipLibCheck": true,  // 外部ライブラリの型チェックをスキップ

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true, // 型チェックのみ、ビルド時に出力ファイルを生成しない → 実際のファイル生成はViteが担当
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
